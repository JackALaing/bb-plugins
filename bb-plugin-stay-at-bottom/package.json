{
  "name": "bb-plugin-stay-at-bottom",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "scripts": {
    "build": "bb plugin build",
    "dev": "bb plugin dev",
    "check": "tsc --noEmit",
    "test": "node --test src/keeper.test.ts"
  },
  "bb": {
    "name": "Stay at bottom",
